# App
NEXT_PUBLIC_APP_NAME=RentalShield NYC
NEXT_PUBLIC_APP_URL=http://localhost:3006
NODE_ENV=development

# AWS / Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_FALLBACK_MODEL_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Geocoding (legacy scam checker)
GOOGLE_MAPS_API_KEY=

# Google Routes (server only, disabled by default)
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=

# RentCast
RENTCAST_API_KEY=

# Optional NYC Open Data token
NYC_OPEN_DATA_APP_TOKEN=

# Optional broker/license lookup configuration
NY_LICENSE_LOOKUP_BASE_URL=

# File upload limits / config
MAX_UPLOAD_FILE_SIZE_MB=10
MAX_UPLOAD_FILE_COUNT=5
